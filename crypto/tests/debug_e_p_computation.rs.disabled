//! Debug why e*P != (e*sk canonical)*G

use goldilocks_crypto::{ScalarField, Point, Fp5Element};
use hex;

#[test]
fn test_e_p_computation() {
    println!("\n=== Debugging e*P Computation ===\n");
    
    let generator = Point::generator();
    
    // Test with sk = 1, e = some value
    let sk = ScalarField::from_bytes_le(&{
        let mut bytes = [0u8; 40];
        bytes[0] = 1;
        bytes
    }).unwrap();
    
    let e = ScalarField::from_bytes_le(&{
        let mut bytes = [0u8; 40];
        bytes[0] = 3; // e = 3
        bytes
    }).unwrap();
    
    println!("Test scalars:");
    println!("  sk: {}...", hex::encode(&sk.to_bytes_le()[..8]));
    println!("  e: {}...", hex::encode(&e.to_bytes_le()[..8]));
    
    // Compute P = sk*G
    println!("\n=== Computing P = sk*G ===");
    let p = generator.mul(&sk);
    let p_encoded = p.encode();
    println!("  P encoded: {}...", hex::encode(&p_encoded.to_bytes_le()[..16]));
    
    // Decode and re-encode to check consistency
    let p_decoded = Point::decode(&Fp5Element::from_bytes_le(&p_encoded.to_bytes_le()).unwrap()).unwrap();
    let p_reencoded = p_decoded.encode();
    println!("  P decoded and re-encoded: {}...", hex::encode(&p_reencoded.to_bytes_le()[..16]));
    println!("  P encoding consistent: {}", p_encoded.0.iter().zip(p_reencoded.0.iter())
        .all(|(a, b)| a.0 == b.0));
    
    // Compute e*P
    println!("\n=== Computing e*P ===");
    let e_p = p.mul(&e);
    let e_p_encoded = e_p.encode();
    println!("  e*P encoded: {}", hex::encode(&e_p_encoded.to_bytes_le()));
    
    // Compute (e*sk canonical)*G
    println!("\n=== Computing (e*sk canonical)*G ===");
    let e_sk_montgomery = e.mul(&sk);
    let e_sk_canonical = e_sk_montgomery.to_canonical();
    println!("  e*sk (Montgomery): {}...", hex::encode(&e_sk_montgomery.to_bytes_le()[..8]));
    println!("  e*sk (canonical): {}...", hex::encode(&e_sk_canonical.to_bytes_le()[..8]));
    
    let e_sk_canonical_g = generator.mul(&e_sk_canonical);
    let e_sk_canonical_g_encoded = e_sk_canonical_g.encode();
    println!("  (e*sk canonical)*G encoded: {}", hex::encode(&e_sk_canonical_g_encoded.to_bytes_le()));
    
    // Compare
    println!("\n=== Comparison ===");
    println!("  e*P == (e*sk canonical)*G: {}", e_p_encoded.0.iter().zip(e_sk_canonical_g_encoded.0.iter())
        .all(|(a, b)| a.0 == b.0));
    
    // Try with e normalized before multiplication
    println!("\n=== Trying with e normalized ===");
    let e_normalized = e.to_canonical();
    println!("  e (original): {}...", hex::encode(&e.to_bytes_le()[..8]));
    println!("  e (normalized): {}...", hex::encode(&e_normalized.to_bytes_le()[..8]));
    println!("  e == e_normalized: {}", e.0 == e_normalized.0);
    
    let e_p_normalized = p.mul(&e_normalized);
    let e_p_normalized_encoded = e_p_normalized.encode();
    println!("  e_normalized*P encoded: {}", hex::encode(&e_p_normalized_encoded.to_bytes_le()));
    println!("  e_normalized*P == (e*sk canonical)*G: {}", e_p_normalized_encoded.0.iter().zip(e_sk_canonical_g_encoded.0.iter())
        .all(|(a, b)| a.0 == b.0));
    
    // Check what form e is in
    println!("\n=== Scalar Form Analysis ===");
    println!("  e from_bytes_le is canonical: true (by definition)");
    println!("  sk from_bytes_le is canonical: true (by definition)");
    println!("  e*sk from mul() is Montgomery: true (mul() returns Montgomery)");
    println!("  e*sk canonical is canonical: true (after to_canonical())");
    
    // Try computing (e*sk)*G directly
    println!("\n=== Computing (e*sk)*G directly (Montgomery) ===");
    let e_sk_montgomery_g = generator.mul(&e_sk_montgomery);
    let e_sk_montgomery_g_encoded = e_sk_montgomery_g.encode();
    println!("  (e*sk Montgomery)*G encoded: {}", hex::encode(&e_sk_montgomery_g_encoded.to_bytes_le()));
    println!("  e*P == (e*sk Montgomery)*G: {}", e_p_encoded.0.iter().zip(e_sk_montgomery_g_encoded.0.iter())
        .all(|(a, b)| a.0 == b.0));
}







