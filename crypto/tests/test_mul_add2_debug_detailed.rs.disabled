//! Detailed debugging test for mul_add2 to identify failures

use goldilocks_crypto::{Point, ScalarField, WeierstrassPoint, Fp5Element};
use hex;

#[test]
fn test_mul_add2_detailed_debug() {
    println!("\n=== Detailed mul_add2 Debugging ===\n");
    
    let generator = Point::generator();
    let generator_ws = WeierstrassPoint::GENERATOR;
    
    // Test with a known failing case (if we can identify one)
    // Use scalars from a real signature that failed
    let s = ScalarField::from_bytes_le(&{
        let mut bytes = [0u8; 40];
        bytes[0] = 1;
        bytes
    }).unwrap();
    
    let e = ScalarField::from_bytes_le(&{
        let mut bytes = [0u8; 40];
        bytes[0] = 3;
        bytes
    }).unwrap();
    
    // Create a public key point
    let sk = ScalarField::from_bytes_le(&{
        let mut bytes = [0u8; 40];
        bytes[0] = 7;
        bytes
    }).unwrap();
    
    let public_key = generator.mul(&sk);
    let public_key_ws = WeierstrassPoint::decode_fp5_as_weierstrass(
        &Fp5Element::from_bytes_le(&public_key.encode().to_bytes_le()).unwrap()
    ).unwrap();
    
    println!("Input scalars:");
    println!("  s: {}", hex::encode(&s.to_bytes_le()));
    println!("  e: {}", hex::encode(&e.to_bytes_le()));
    println!("  sk: {}", hex::encode(&sk.to_bytes_le()));
    
    println!("\n4-bit limbs:");
    let s_limbs = s.split_to_4bit_limbs();
    let e_limbs = e.split_to_4bit_limbs();
    println!("  s_limbs[0] (LSB): {}", s_limbs[0]);
    println!("  s_limbs[79] (MSB): {}", s_limbs[79]);
    println!("  e_limbs[0] (LSB): {}", e_limbs[0]);
    println!("  e_limbs[79] (MSB): {}", e_limbs[79]);
    
    // Compute with Point::mul_add2
    println!("\n=== Point::mul_add2 ===");
    let result_point = Point::mul_add2(&generator, &public_key, &s, &e);
    let result_point_encoded = result_point.encode();
    println!("  Result: {}", hex::encode(&result_point_encoded.to_bytes_le()));
    
    // Compute with WeierstrassPoint::mul_add2
    println!("\n=== WeierstrassPoint::mul_add2 ===");
    let result_ws = WeierstrassPoint::mul_add2(&generator_ws, &public_key_ws, &s, &e);
    let result_ws_encoded = result_ws.encode();
    println!("  Result: {}", hex::encode(&result_ws_encoded.to_bytes_le()));
    
    // Compare
    let match_result = result_point_encoded.0.iter().zip(result_ws_encoded.0.iter())
        .all(|(a, b)| a.0 == b.0);
    
    if match_result {
        println!("\n✅ Point::mul_add2 == WeierstrassPoint::mul_add2");
    } else {
        println!("\n❌ Point::mul_add2 != WeierstrassPoint::mul_add2");
        println!("  This indicates a bug in Point::mul_add2!");
        
        // Try converting Point result to WeierstrassPoint and compare
        let result_point_as_ws = WeierstrassPoint::decode_fp5_as_weierstrass(&result_point_encoded);
        if let Some(ws_pt) = result_point_as_ws {
            let ws_pt_encoded = ws_pt.encode();
            let match_ws = result_ws_encoded.0.iter().zip(ws_pt_encoded.0.iter())
                .all(|(a, b)| a.0 == b.0);
            println!("  Point result as WeierstrassPoint matches: {}", match_ws);
        }
    }
    
    // Also compute expected: (s + e*sk) * G
    let e_times_sk = e.mul(&sk);
    let e_times_sk_canonical = e_times_sk.to_canonical();
    let k_reconstructed = s.add(e_times_sk_canonical);
    let expected = generator.mul(&k_reconstructed);
    let expected_encoded = expected.encode();
    
    println!("\n=== Expected (k*G where k = s + e*sk) ===");
    println!("  Result: {}", hex::encode(&expected_encoded.to_bytes_le()));
    
    let match_expected_point = result_point_encoded.0.iter().zip(expected_encoded.0.iter())
        .all(|(a, b)| a.0 == b.0);
    let match_expected_ws = result_ws_encoded.0.iter().zip(expected_encoded.0.iter())
        .all(|(a, b)| a.0 == b.0);
    
    println!("\nComparison:");
    println!("  Point::mul_add2 matches expected: {}", match_expected_point);
    println!("  WeierstrassPoint::mul_add2 matches expected: {}", match_expected_ws);
}

#[test]
fn test_mul_add2_with_failing_signature() {
    println!("\n=== Testing mul_add2 with Real Failing Signature ===\n");
    
    // Use values from a real failing signature (from debug output)
    // This test will help identify the exact failure point
    
    let generator = Point::generator();
    
    // Generate random scalars to simulate a real signature
    let s = ScalarField::sample_crypto();
    let e = ScalarField::sample_crypto();
    let sk = ScalarField::sample_crypto();
    
    let public_key = generator.mul(&sk);
    
    println!("Testing with random scalars:");
    println!("  s: {}...", hex::encode(&s.to_bytes_le()[..8]));
    println!("  e: {}...", hex::encode(&e.to_bytes_le()[..8]));
    println!("  sk: {}...", hex::encode(&sk.to_bytes_le()[..8]));
    
    // Compute R using mul_add2
    let r_computed = Point::mul_add2(&generator, &public_key, &s, &e);
    let r_computed_encoded = r_computed.encode();
    
    // Compute expected: k*G where k = s + e*sk
    let e_times_sk = e.mul(&sk);
    let e_times_sk_canonical = e_times_sk.to_canonical();
    let k = s.add(e_times_sk_canonical);
    let r_expected = generator.mul(&k);
    let r_expected_encoded = r_expected.encode();
    
    println!("\nResults:");
    println!("  Computed R: {}...", hex::encode(&r_computed_encoded.to_bytes_le()[..16]));
    println!("  Expected R: {}...", hex::encode(&r_expected_encoded.to_bytes_le()[..16]));
    
    let match_result = r_computed_encoded.0.iter().zip(r_expected_encoded.0.iter())
        .all(|(a, b)| a.0 == b.0);
    
    if match_result {
        println!("\n✅ mul_add2 correctly computes s*G + e*P");
    } else {
        println!("\n❌ mul_add2 does NOT correctly compute s*G + e*P");
        println!("  This is the bug causing verification failures!");
        
        // Detailed comparison
        println!("\nDetailed comparison:");
        for i in 0..5 {
            let computed = r_computed_encoded.0[i].0;
            let expected = r_expected_encoded.0[i].0;
            if computed != expected {
                println!("  Element[{}]: computed=0x{:016x}, expected=0x{:016x}, diff=0x{:016x}",
                    i, computed, expected, computed ^ expected);
            }
        }
    }
}








