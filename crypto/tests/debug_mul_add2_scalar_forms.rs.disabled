//! Test to see if mul_add2 needs scalars in the same form

use goldilocks_crypto::{ScalarField, Point, Fp5Element};
use hex;

#[test]
fn test_mul_add2_scalar_forms() {
    println!("\n=== Testing mul_add2 with Different Scalar Forms ===\n");
    
    let generator = Point::generator();
    let sk = ScalarField::from_bytes_le(&{
        let mut bytes = [0u8; 40];
        bytes[0] = 1;
        bytes
    }).unwrap();
    
    let s = ScalarField::from_bytes_le(&{
        let mut bytes = [0u8; 40];
        bytes[0] = 5;
        bytes
    }).unwrap();
    
    let e = ScalarField::from_bytes_le(&{
        let mut bytes = [0u8; 40];
        bytes[0] = 3;
        bytes
    }).unwrap();
    
    let public_point = generator.mul(&sk);
    
    println!("Test scalars:");
    println!("  s (canonical): {}...", hex::encode(&s.to_bytes_le()[..8]));
    println!("  e (canonical): {}...", hex::encode(&e.to_bytes_le()[..8]));
    
    // Expected: k = s + e*sk
    let e_sk = e.mul(&sk);
    let e_sk_canonical = e_sk.to_canonical();
    let k = s.add(e_sk_canonical);
    let expected_r = generator.mul(&k);
    let expected_r_encoded = expected_r.encode();
    
    println!("\nExpected R (k*G):");
    println!("  {}", hex::encode(&expected_r_encoded.to_bytes_le()));
    
    // Try different combinations
    println!("\n=== Testing Different Scalar Form Combinations ===\n");
    
    // Approach 1: Both canonical
    println!("Approach 1: s (canonical) + e (canonical)");
    let r1 = Point::mul_add2(&generator, &public_point, &s, &e);
    let r1_encoded = r1.encode();
    let match1 = expected_r_encoded.0.iter().zip(r1_encoded.0.iter())
        .all(|(a, b)| a.0 == b.0);
    println!("  Result: {}...", hex::encode(&r1_encoded.to_bytes_le()[..16]));
    println!("  Matches: {}", match1);
    println!("  Valid point: {}", !r1_encoded.to_bytes_le().iter().any(|&b| b == 0xff));
    
    // Approach 2: s canonical, e/R
    println!("\nApproach 2: s (canonical) + e/R");
    let e_div_r = e.monty_mul(&ScalarField::ONE);
    let r2 = Point::mul_add2(&generator, &public_point, &s, &e_div_r);
    let r2_encoded = r2.encode();
    let match2 = expected_r_encoded.0.iter().zip(r2_encoded.0.iter())
        .all(|(a, b)| a.0 == b.0);
    println!("  e/R: {}...", hex::encode(&e_div_r.to_bytes_le()[..8]));
    println!("  Result: {}...", hex::encode(&r2_encoded.to_bytes_le()[..16]));
    println!("  Matches: {}", match2);
    println!("  Valid point: {}", !r2_encoded.to_bytes_le().iter().any(|&b| b == 0xff));
    
    // Approach 3: Both in Montgomery form
    println!("\nApproach 3: s*R2 (Montgomery) + e*R2 (Montgomery)");
    let s_montgomery = s.monty_mul(&ScalarField::R2);
    let e_montgomery = e.monty_mul(&ScalarField::R2);
    let r3 = Point::mul_add2(&generator, &public_point, &s_montgomery, &e_montgomery);
    let r3_encoded = r3.encode();
    let match3 = expected_r_encoded.0.iter().zip(r3_encoded.0.iter())
        .all(|(a, b)| a.0 == b.0);
    println!("  Result: {}...", hex::encode(&r3_encoded.to_bytes_le()[..16]));
    println!("  Matches: {}", match3);
    
    // Approach 4: s canonical, e*R2
    println!("\nApproach 4: s (canonical) + e*R2 (Montgomery)");
    let e_r2 = e.monty_mul(&ScalarField::R2);
    let r4 = Point::mul_add2(&generator, &public_point, &s, &e_r2);
    let r4_encoded = r4.encode();
    let match4 = expected_r_encoded.0.iter().zip(r4_encoded.0.iter())
        .all(|(a, b)| a.0 == b.0);
    println!("  Result: {}...", hex::encode(&r4_encoded.to_bytes_le()[..16]));
    println!("  Matches: {}", match4);
    
    println!("\n=== Summary ===");
    println!("  Approach 1 (both canonical): {}", if match1 { "✅" } else { "❌" });
    println!("  Approach 2 (s canonical, e/R): {}", if match2 { "✅" } else { "❌" });
    println!("  Approach 3 (both Montgomery): {}", if match3 { "✅" } else { "❌" });
    println!("  Approach 4 (s canonical, e*R2): {}", if match4 { "✅" } else { "❌" });
}







