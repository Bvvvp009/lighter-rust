//! Debug test to understand why some verifications fail

use goldilocks_crypto::{ScalarField, Point, sign, verify_signature};
use hex;

#[test]
fn test_debug_failed_verification() {
    println!("\n=== Debug Failed Verification ===\n");
    
    let private_key = ScalarField::sample_crypto();
    let private_key_bytes = private_key.to_bytes_le();
    
    let public_key_point = Point::generator().mul(&private_key);
    let public_key_bytes = public_key_point.encode().to_bytes_le();
    
    let message = [0u8; 40];
    
    let mut success_count = 0;
    let mut fail_count = 0;
    let mut failed_cases = Vec::new();
    
    // Test multiple signatures
    for i in 0..20 {
        let signature = sign(&private_key_bytes, &message)
            .expect("Failed to sign");
        
        let is_valid = verify_signature(&signature, &message, &public_key_bytes)
            .expect("Failed to verify");
        
        if is_valid {
            success_count += 1;
        } else {
            fail_count += 1;
            if failed_cases.len() < 3 {
                failed_cases.push((i, signature.clone()));
            }
        }
    }
    
    println!("Results: {}/20 succeeded, {}/20 failed", success_count, fail_count);
    
    if fail_count > 0 {
        println!("\n=== Analyzing Failed Cases ===\n");
        
        for (case_num, signature) in failed_cases {
            println!("Case {}:", case_num);
            
            // Extract s and e
            let s_bytes = &signature[0..40];
            let e_bytes = &signature[40..80];
            let s = ScalarField::from_bytes_le(s_bytes).unwrap();
            let e = ScalarField::from_bytes_le(e_bytes).unwrap();
            
            println!("  s: {}", hex::encode(s_bytes));
            println!("  e: {}", hex::encode(e_bytes));
            
            // Reconstruct R
            let generator = Point::generator();
            let public_point = Point::decode(&goldilocks_crypto::Fp5Element::from_bytes_le(&public_key_bytes).unwrap())
                .expect("Failed to decode public key");
            
            let s_g = generator.mul(&s);
            let e_pk = public_point.mul(&e);
            let r_point = s_g.add(&e_pk);
            let r_encoded = r_point.encode();
            
            // Just call verify_signature which will do all the computation and logging
            // The debug logging in verify_signature will print detailed information
            let _ = verify_signature(&signature, &message, &public_key_bytes);
            println!();
        }
    } else {
        println!("✅ All signatures verified successfully!");
    }
}

