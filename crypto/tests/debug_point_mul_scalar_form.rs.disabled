//! Debug test to check if Point::mul() handles scalar forms correctly

use goldilocks_crypto::{ScalarField, Point};
use hex;

#[test]
fn test_point_mul_scalar_form() {
    println!("\n=== Debug: Point::mul() Scalar Form ===\n");
    
    let generator = Point::generator();
    let sk = ScalarField::sample_crypto();
    let e = ScalarField::sample_crypto();
    
    println!("sk: {}...", hex::encode(&sk.to_bytes_le()[..8]));
    println!("e: {}...", hex::encode(&e.to_bytes_le()[..8]));
    
    // Compute P = sk*G
    let public_key = generator.mul(&sk);
    let public_key_encoded = public_key.encode();
    println!("P = sk*G: {}...", hex::encode(&public_key_encoded.to_bytes_le()[..16]));
    
    // Compute e*P using Point::mul()
    let e_pk = public_key.mul(&e);
    let e_pk_encoded = e_pk.encode();
    println!("e*P (using Point::mul): {}...", hex::encode(&e_pk_encoded.to_bytes_le()[..16]));
    
    // Compute e*sk and then (e*sk)*G
    let e_sk = e.mul(&sk);
    let e_sk_canonical = e_sk.to_canonical();
    println!("e*sk (canonical): {}...", hex::encode(&e_sk_canonical.to_bytes_le()[..8]));
    
    let e_sk_g = generator.mul(&e_sk_canonical);
    let e_sk_g_encoded = e_sk_g.encode();
    println!("(e*sk canonical)*G: {}...", hex::encode(&e_sk_g_encoded.to_bytes_le()[..16]));
    
    println!("\ne*P == (e*sk canonical)*G: {}", e_pk_encoded.to_bytes_le() == e_sk_g_encoded.to_bytes_le());
    
    // Also test with e*sk in Montgomery form
    let e_sk_g_montgomery = generator.mul(&e_sk);
    let e_sk_g_montgomery_encoded = e_sk_g_montgomery.encode();
    println!("(e*sk Montgomery)*G: {}...", hex::encode(&e_sk_g_montgomery_encoded.to_bytes_le()[..16]));
    println!("e*P == (e*sk Montgomery)*G: {}", e_pk_encoded.to_bytes_le() == e_sk_g_montgomery_encoded.to_bytes_le());
    
    // Test: what if we use e in Montgomery form?
    let e_montgomery = e.monty_mul(&ScalarField::R2);
    let e_pk_montgomery = public_key.mul(&e_montgomery);
    let e_pk_montgomery_encoded = e_pk_montgomery.encode();
    println!("\ne*P (e in Montgomery): {}...", hex::encode(&e_pk_montgomery_encoded.to_bytes_le()[..16]));
    println!("e*P == e*P (Montgomery e): {}", e_pk_encoded.to_bytes_le() == e_pk_montgomery_encoded.to_bytes_le());
}



