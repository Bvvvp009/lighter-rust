//! Compare message encoding to understand hash mismatch

use goldilocks_crypto::Fp5Element;
use poseidon_hash::Goldilocks;
use hex;

#[test]
fn test_message_encoding_comparison() {
    println!("\n=== Comparing Message Encoding ===\n");
    
    // Message from Go signature test
    let message_hex = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f2021222324252627";
    let message = hex::decode(message_hex).unwrap();
    
    println!("Message bytes: {}", message_hex);
    println!("Message length: {} bytes", message.len());
    
    // Method 1: Our message_to_fp5 (reverses bytes)
    println!("\n=== Method 1: message_to_fp5 (reverses bytes) ===");
    let mut message_elements_reversed = [Goldilocks::zero(); 5];
    for (i, chunk) in message.chunks(8).enumerate().take(5) {
        let mut bytes = [0u8; 8];
        bytes[..chunk.len()].copy_from_slice(chunk);
        bytes.reverse();
        message_elements_reversed[i] = Goldilocks::from_canonical_u64(u64::from_be_bytes(bytes));
        println!("  Chunk {}: bytes={}, reversed={}, value={}", 
            i, 
            hex::encode(chunk),
            hex::encode(&bytes),
            message_elements_reversed[i].0
        );
    }
    let message_fp5_reversed = Fp5Element(message_elements_reversed);
    println!("  Fp5Element: {:?}", message_fp5_reversed.0.iter().map(|g| g.0).collect::<Vec<_>>());
    
    // Method 2: Direct little-endian (no reversal)
    println!("\n=== Method 2: Direct little-endian (no reversal) ===");
    let mut message_elements_direct = [Goldilocks::zero(); 5];
    for (i, chunk) in message.chunks(8).enumerate().take(5) {
        let mut bytes = [0u8; 8];
        bytes[..chunk.len()].copy_from_slice(chunk);
        message_elements_direct[i] = Goldilocks::from_canonical_u64(u64::from_le_bytes(bytes));
        println!("  Chunk {}: bytes={}, value={}", 
            i, 
            hex::encode(chunk),
            message_elements_direct[i].0
        );
    }
    let message_fp5_direct = Fp5Element(message_elements_direct);
    println!("  Fp5Element: {:?}", message_fp5_direct.0.iter().map(|g| g.0).collect::<Vec<_>>());
    
    // Method 3: Using Fp5Element::from_bytes_le
    println!("\n=== Method 3: Fp5Element::from_bytes_le ===");
    let message_fp5_from_bytes = Fp5Element::from_bytes_le(&message).unwrap();
    println!("  Fp5Element: {:?}", message_fp5_from_bytes.0.iter().map(|g| g.0).collect::<Vec<_>>());
    
    // Compare
    println!("\n=== Comparison ===");
    println!("  Method 1 (reversed) == Method 2 (direct): {}", 
        message_fp5_reversed.0.iter().zip(message_fp5_direct.0.iter())
            .all(|(a, b)| a.0 == b.0));
    println!("  Method 1 (reversed) == Method 3 (from_bytes_le): {}", 
        message_fp5_reversed.0.iter().zip(message_fp5_from_bytes.0.iter())
            .all(|(a, b)| a.0 == b.0));
    println!("  Method 2 (direct) == Method 3 (from_bytes_le): {}", 
        message_fp5_direct.0.iter().zip(message_fp5_from_bytes.0.iter())
            .all(|(a, b)| a.0 == b.0));
    
    // Check what Go's FromCanonicalLittleEndianBytes actually does
    // Based on the name and comments, it should:
    // 1. Take little-endian bytes
    // 2. Reverse them (to get big-endian)
    // 3. Interpret as big-endian u64
    // This matches Method 1
    
    println!("\n✅ Method 1 (reversed) should match Go's FromCanonicalLittleEndianBytes");
}







