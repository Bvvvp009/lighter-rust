//! Detailed step-by-step debugging of signing vs verification

use goldilocks_crypto::{ScalarField, Point, sign, verify_signature};
use poseidon_hash::{hash_to_quintic_extension, Goldilocks};
use hex;

#[test]
fn test_verification_step_by_step() {
    println!("\n=== Step-by-Step Verification Debug ===\n");
    
    // Generate test values
    let private_key = ScalarField::sample_crypto();
    let private_key_bytes = private_key.to_bytes_le();
    
    let public_key_point = Point::generator().mul(&private_key);
    let public_key_bytes = public_key_point.encode().to_bytes_le();
    
    let message = [0u8; 40];
    
    println!("Private key: {}...", hex::encode(&private_key_bytes[..8]));
    println!("Public key: {}...", hex::encode(&public_key_bytes[..8]));
    println!("Message: {}...", hex::encode(&message[..8]));
    
    // === SIGNING ===
    println!("\n=== SIGNING PROCESS ===");
    
    // Sign the message
    let signature = sign(&private_key_bytes, &message).unwrap();
    println!("Signature length: {} bytes", signature.len());
    
    // Extract s and e
    let s_bytes = &signature[0..40];
    let e_bytes = &signature[40..80];
    let s = ScalarField::from_bytes_le(s_bytes).unwrap();
    let e = ScalarField::from_bytes_le(e_bytes).unwrap();
    
    println!("s: {}...", hex::encode(&s.to_bytes_le()[..8]));
    println!("e: {}...", hex::encode(&e.to_bytes_le()[..8]));
    
    // Reconstruct what happened during signing
    // We need to trace through the signing process
    // message_to_fp5 is private, so we'll recreate it
    fn message_to_fp5(message: &[u8]) -> Result<goldilocks_crypto::Fp5Element, String> {
        if message.len() != 40 {
            return Err(format!("Invalid message length: {}", message.len()));
        }
        let mut message_elements = [Goldilocks::zero(); 5];
        for (i, chunk) in message.chunks(8).enumerate().take(5) {
            let mut bytes = [0u8; 8];
            bytes[..chunk.len()].copy_from_slice(chunk);
            bytes.reverse();
            message_elements[i] = Goldilocks::from_canonical_u64(u64::from_be_bytes(bytes));
        }
        Ok(goldilocks_crypto::Fp5Element(message_elements))
    }
    
    // During signing: nonce was generated, R was computed, e was computed
    // We can't reconstruct the exact nonce, but we can verify the relationship
    
    // Reconstruct k = s + e*sk
    let e_sk = e.mul(&private_key);
    let k_reconstructed = s.add(e_sk);
    
    println!("\nReconstructing k = s + e*sk:");
    println!("  e*sk: {}...", hex::encode(&e_sk.to_bytes_le()[..8]));
    println!("  k: {}...", hex::encode(&k_reconstructed.to_bytes_le()[..8]));
    
    // Compute R from k (what signing did)
    let generator = Point::generator();
    let r_signing = generator.mul(&k_reconstructed);
    let r_signing_encoded = r_signing.encode();
    
    println!("\nR from signing (k*G):");
    println!("  Encoded: {}...", hex::encode(&r_signing_encoded.to_bytes_le()[..16]));
    for i in 0..5 {
        println!("  R[{}] = {}", i, r_signing_encoded.0[i].0);
    }
    
    // Message encoding during signing
    let message_fp5_signing = message_to_fp5(&message).unwrap();
    println!("\nMessage Fp5Element (during signing):");
    for i in 0..5 {
        println!("  M[{}] = {}", i, message_fp5_signing.0[i].0);
    }
    
    // Hash during signing
    let mut pre_image_signing = [Goldilocks::zero(); 10];
    pre_image_signing[..5].copy_from_slice(&r_signing_encoded.0);
    pre_image_signing[5..].copy_from_slice(&message_fp5_signing.0);
    
    println!("\nPre-image for hash (during signing):");
    for i in 0..10 {
        if i < 5 {
            println!("  [{}] R[{}] = {}", i, i, pre_image_signing[i].0);
        } else {
            println!("  [{}] M[{}] = {}", i, i-5, pre_image_signing[i].0);
        }
    }
    
    let e_signing_fp5 = hash_to_quintic_extension(&pre_image_signing);
    let e_signing_scalar = ScalarField::from_fp5_element(&e_signing_fp5);
    
    println!("\nHash result (e from signing):");
    println!("  e: {}...", hex::encode(&e_signing_scalar.to_bytes_le()[..8]));
    println!("  e (full): {}", hex::encode(&e_signing_scalar.to_bytes_le()));
    println!("  e from signature: {}", hex::encode(&e.to_bytes_le()));
    println!("  Match: {}", e_signing_scalar.to_bytes_le() == e.to_bytes_le());
    
    // === VERIFICATION ===
    println!("\n=== VERIFICATION PROCESS ===");
    
    // Decode public key
    let public_key_fp5 = goldilocks_crypto::Fp5Element::from_bytes_le(&public_key_bytes).unwrap();
    let public_point = Point::decode(&public_key_fp5).unwrap();
    
    println!("Public key decoded successfully");
    
    // Compute R = s*G + e*P
    let r_verification = Point::mul_add2(&generator, &public_point, &s, &e);
    let r_verification_encoded = r_verification.encode();
    
    println!("\nR from verification (s*G + e*P):");
    println!("  Encoded: {}...", hex::encode(&r_verification_encoded.to_bytes_le()[..16]));
    for i in 0..5 {
        println!("  R[{}] = {}", i, r_verification_encoded.0[i].0);
    }
    
    // Compare R values
    println!("\n=== R COMPARISON ===");
    let r_match = r_signing_encoded.to_bytes_le() == r_verification_encoded.to_bytes_le();
    println!("R (signing) == R (verification): {}", r_match);
    
    if !r_match {
        println!("❌ R values don't match!");
        for i in 0..5 {
            if r_signing_encoded.0[i].0 != r_verification_encoded.0[i].0 {
                println!("  R[{}] differs: signing={}, verification={}", 
                    i, r_signing_encoded.0[i].0, r_verification_encoded.0[i].0);
            }
        }
    } else {
        println!("✅ R values match!");
    }
    
    // Message encoding during verification
    let message_fp5_verification = message_to_fp5(&message).unwrap();
    println!("\nMessage Fp5Element (during verification):");
    for i in 0..5 {
        println!("  M[{}] = {}", i, message_fp5_verification.0[i].0);
    }
    
    // Compare message encodings
    let message_match = message_fp5_signing.0.iter().zip(message_fp5_verification.0.iter())
        .all(|(a, b)| a.0 == b.0);
    println!("Message encoding match: {}", message_match);
    
    // Hash during verification
    let mut pre_image_verification = [Goldilocks::zero(); 10];
    pre_image_verification[..5].copy_from_slice(&r_verification_encoded.0);
    pre_image_verification[5..].copy_from_slice(&message_fp5_verification.0);
    
    println!("\nPre-image for hash (during verification):");
    for i in 0..10 {
        if i < 5 {
            println!("  [{}] R[{}] = {}", i, i, pre_image_verification[i].0);
        } else {
            println!("  [{}] M[{}] = {}", i, i-5, pre_image_verification[i].0);
        }
    }
    
    // Compare pre-images
    let pre_image_match = pre_image_signing.iter().zip(pre_image_verification.iter())
        .all(|(a, b)| a.0 == b.0);
    println!("\nPre-image match: {}", pre_image_match);
    
    if !pre_image_match {
        println!("❌ Pre-images differ!");
        for i in 0..10 {
            if pre_image_signing[i].0 != pre_image_verification[i].0 {
                println!("  Pre-image[{}] differs: signing={}, verification={}", 
                    i, pre_image_signing[i].0, pre_image_verification[i].0);
            }
        }
    }
    
    let e_verification_fp5 = hash_to_quintic_extension(&pre_image_verification);
    let e_verification_scalar = ScalarField::from_fp5_element(&e_verification_fp5);
    
    println!("\nHash result (e' from verification):");
    println!("  e': {}...", hex::encode(&e_verification_scalar.to_bytes_le()[..8]));
    println!("  e' (full): {}", hex::encode(&e_verification_scalar.to_bytes_le()));
    println!("  e from signature: {}", hex::encode(&e.to_bytes_le()));
    println!("  Match: {}", e_verification_scalar.to_bytes_le() == e.to_bytes_le());
    
    // Final verification
    println!("\n=== FINAL VERIFICATION ===");
    let is_valid = verify_signature(&signature, &message, &public_key_bytes).unwrap();
    println!("verify_signature() result: {}", is_valid);
    
    if !is_valid {
        println!("\n❌ VERIFICATION FAILED");
        println!("Root cause analysis:");
        if !r_match {
            println!("  - R values don't match (this is the problem!)");
        } else if !message_match {
            println!("  - Message encodings don't match");
        } else if !pre_image_match {
            println!("  - Pre-images don't match (even though R and message match?)");
        } else {
            println!("  - Hash computation issue (pre-images match but hash differs)");
        }
    } else {
        println!("\n✅ VERIFICATION PASSED");
    }
}

