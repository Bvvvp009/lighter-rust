//! Test WeierstrassPoint::mul_add2 to see if it works correctly

use goldilocks_crypto::{ScalarField, Point, WeierstrassPoint, Fp5Element};
use hex;

#[test]
fn test_weierstrass_mul_add2() {
    println!("\n=== Testing WeierstrassPoint::mul_add2 ===\n");
    
    // Get generator as WeierstrassPoint (use the constant)
    let generator = WeierstrassPoint::GENERATOR;
    let generator_point = Point::generator();
    
    // Test values
    let s = ScalarField::from_bytes_le(&{
        let mut bytes = [0u8; 40];
        bytes[0] = 5; // s = 5
        bytes
    }).unwrap();
    
    let e = ScalarField::from_bytes_le(&{
        let mut bytes = [0u8; 40];
        bytes[0] = 3; // e = 3
        bytes
    }).unwrap();
    
    let sk = ScalarField::from_bytes_le(&{
        let mut bytes = [0u8; 40];
        bytes[0] = 7; // sk = 7
        bytes
    }).unwrap();
    
    // Compute public key as WeierstrassPoint
    // Convert Point to WeierstrassPoint via encoding
    let public_key_point = generator_point.mul(&sk);
    let public_key_encoded = public_key_point.encode();
    let public_key = WeierstrassPoint::decode_fp5_as_weierstrass(&public_key_encoded)
        .expect("Failed to decode public key as WeierstrassPoint");
    
    println!("Test values:");
    println!("  s: {}...", hex::encode(&s.to_bytes_le()[..8]));
    println!("  e: {}...", hex::encode(&e.to_bytes_le()[..8]));
    println!("  sk: {}...", hex::encode(&sk.to_bytes_le()[..8]));
    
    // Compute expected: k = s + e*sk (canonical)
    let e_times_sk = e.mul(&sk);
    let e_times_sk_canonical = e_times_sk.to_canonical();
    let k = s.add(e_times_sk_canonical);
    let expected_r_point = generator_point.mul(&k);
    let expected_r_encoded = expected_r_point.encode();
    let expected_r = WeierstrassPoint::decode_fp5_as_weierstrass(&expected_r_encoded)
        .expect("Failed to decode expected R as WeierstrassPoint");
    let expected_encoded = expected_r.encode();
    
    println!("\nExpected R (k*G where k = s + e*sk canonical):");
    println!("  k: {}...", hex::encode(&k.to_bytes_le()[..8]));
    println!("  R: {}...", hex::encode(&expected_encoded.to_bytes_le()[..16]));
    
    // Test: WeierstrassPoint::mul_add2
    let result = WeierstrassPoint::mul_add2(&generator, &public_key, &s, &e);
    let result_encoded = result.encode();
    
    println!("\nWeierstrassPoint::mul_add2 result:");
    println!("  Result: {}...", hex::encode(&result_encoded.to_bytes_le()[..16]));
    
    // Compare
    let match_result = result_encoded.0.iter().zip(expected_encoded.0.iter())
        .all(|(a, b)| a.0 == b.0);
    
    println!("\nComparison:");
    println!("  WeierstrassPoint::mul_add2 == k*G: {}", match_result);
    
    if match_result {
        println!("\n✅ WeierstrassPoint::mul_add2 works correctly!");
        println!("   We should use WeierstrassPoint for verification!");
    } else {
        println!("\n❌ WeierstrassPoint::mul_add2 also fails");
        
        // Check if it's at least better than Point::mul_add2
        let point_result = Point::mul_add2(&generator_point, &public_key_point, &s, &e);
        let point_encoded = point_result.encode();
        let point_match = point_encoded.0.iter().zip(expected_encoded.0.iter())
            .all(|(a, b)| a.0 == b.0);
        println!("  Point::mul_add2 == k*G: {}", point_match);
        
        if !point_match {
            println!("  Both implementations fail, but checking if they match each other:");
            let both_match = result_encoded.0.iter().zip(point_encoded.0.iter())
                .all(|(a, b)| a.0 == b.0);
            println!("  WeierstrassPoint::mul_add2 == Point::mul_add2: {}", both_match);
        }
    }
}

