//! Debug test: Verify k reconstruction works correctly

use goldilocks_crypto::{ScalarField, Point};
use hex;

#[test]
fn test_k_reconstruction() {
    println!("\n=== Debug: k Reconstruction ===\n");
    
    let k = ScalarField::sample_crypto();
    let sk = ScalarField::sample_crypto();
    let e = ScalarField::sample_crypto();
    
    println!("k: {}...", hex::encode(&k.to_bytes_le()[..8]));
    println!("sk: {}...", hex::encode(&sk.to_bytes_le()[..8]));
    println!("e: {}...", hex::encode(&e.to_bytes_le()[..8]));
    
    // Compute e*sk
    let e_sk = e.mul(&sk);
    println!("e*sk (Montgomery): {}...", hex::encode(&e_sk.to_bytes_le()[..8]));
    
    let e_sk_canonical = e_sk.to_canonical();
    println!("e*sk (canonical): {}...", hex::encode(&e_sk_canonical.to_bytes_le()[..8]));
    
    // Compute s = k - e*sk (canonical)
    let s = k.sub(e_sk_canonical);
    println!("s = k - e*sk (canonical): {}...", hex::encode(&s.to_bytes_le()[..8]));
    
    // Reconstruct k = s + e*sk
    let k_reconstructed = s.add(e_sk_canonical);
    println!("\n=== k Reconstruction ===");
    println!("k (original): {}...", hex::encode(&k.to_bytes_le()[..8]));
    println!("k (reconstructed): {}...", hex::encode(&k_reconstructed.to_bytes_le()[..8]));
    println!("k == k_reconstructed: {}", k.to_bytes_le() == k_reconstructed.to_bytes_le());
    
    // Test point arithmetic
    println!("\n=== Point Arithmetic ===");
    let generator = Point::generator();
    
    // R from signing: k*G
    let r_signing = generator.mul(&k);
    let r_signing_encoded = r_signing.encode();
    println!("R from signing (k*G): {}", hex::encode(&r_signing_encoded.to_bytes_le()));
    
    // R from verification: s*G + e*sk*G
    let s_g = generator.mul(&s);
    let e_sk_g = generator.mul(&e_sk_canonical);
    let r_verification = s_g.add(&e_sk_g);
    let r_verification_encoded = r_verification.encode();
    println!("R from verification (s*G + e*sk*G): {}", hex::encode(&r_verification_encoded.to_bytes_le()));
    println!("R match: {}", r_signing_encoded.to_bytes_le() == r_verification_encoded.to_bytes_le());
    
    // Also test: what if we use k_reconstructed directly?
    let r_using_k_reconstructed = generator.mul(&k_reconstructed);
    let r_using_k_reconstructed_encoded = r_using_k_reconstructed.encode();
    println!("R using k_reconstructed: {}", hex::encode(&r_using_k_reconstructed_encoded.to_bytes_le()));
    println!("R signing == R using k_reconstructed: {}", r_signing_encoded.to_bytes_le() == r_using_k_reconstructed_encoded.to_bytes_le());
}



